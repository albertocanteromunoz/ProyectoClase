<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="2 DAW vocational training centre: web development, databases and user interface design.">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">
  </head>
  <body>
    <header class="header">
      <div class="header-container">
        <a href="#about" class="logo">2 DAW</a>
        <nav class="nav" aria-label="Primary">
          <ul>
            <li><a href="#about" class="nav-link">About</a></li>
            <li><a href="#courses" class="nav-link">Courses</a></li>
            <li><a href="#campus" class="nav-link">Campus</a></li>
            <li><a href="#contact" class="nav-link">Contact</a></li>
          </ul>
        </nav>
        <div class="nav-toggle" id="navToggle" aria-label="Open menu" tabindex="0">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    </header>

    <div class="offcanvas-overlay" id="offcanvasOverlay"></div>
    <aside class="offcanvas" id="offcanvas">
      <p class="offcanvas-title">Menu</p>
      <nav aria-label="Off canvas">
        <ul>
          <li><a href="#about" class="nav-link">About</a></li>
          <li><a href="#courses" class="nav-link">Courses</a></li>
          <li><a href="#campus" class="nav-link">Campus</a></li>
          <li><a href="#contact" class="nav-link">Contact</a></li>
        </ul>
      </nav>
    </aside>

    <main>
      <section class="hero">
        <img src="https://picsum.photos/id/180/1600/700" alt="Students working in a web development classroom">
        <div class="hero-content">
          <p class="eyebrow">Vocational training centre</p>
          <h1>Welcome to 2 DAW</h1>
          <p>
            A vocational centre focused on practical training for web development, databases and user interface design.
          </p>
          <a class="btn" href="#courses">See our courses</a>
        </div>
      </section>

      <section id="about" class="section">
        <div class="container">
          <h2>What is 2 DAW?</h2>
          <p>
            <strong>2 DAW</strong> is a training centre that offers quality learning resources adapted to student needs. We combine modern tools with a practical approach so learners can build professional skills for current educational and workplace environments.
          </p>
          <div class="about-row">
            <figure>
              <img src="https://picsum.photos/id/0/800/520" alt="Laptop used for software development practice">
            </figure>
            <ul class="about-list">
              <li>Experienced teachers committed to educational innovation.</li>
              <li>Courses updated according to labour market demand.</li>
              <li>24/7 access to learning materials and personalised support.</li>
              <li>A secure digital environment that is easy to use.</li>
            </ul>
          </div>
        </div>
      </section>

      <section id="courses" class="section section-alt">
        <div class="container">
          <h2>Our courses</h2>
          <div class="card-row">
            <article class="course-card">
              <img src="https://picsum.photos/id/119/640/380" alt="Workspace for full stack web development">
              <div class="course-body">
                <h3>Full Stack Web Development</h3>
                <p>
                  Learn to create and deploy web applications using HTML5, CSS3, JavaScript, Node.js and Express. Real projects with a focus on employability.
                </p>
              </div>
            </article>
            <article class="course-card">
              <img src="https://picsum.photos/id/60/640/380" alt="Technical workspace for database practice">
              <div class="course-body">
                <h3>Advanced Databases</h3>
                <p>
                  Master database design and management with SQL, NoSQL and modern tools needed to build robust projects.
                </p>
              </div>
            </article>
            <article class="course-card">
              <img src="https://picsum.photos/id/201/640/380" alt="Design materials for user interface classes">
              <div class="course-body">
                <h3>User Interface Design</h3>
                <p>
                  Explore UX/UI principles, adaptive design and the creation of attractive digital experiences from scratch.
                </p>
              </div>
            </article>
          </div>
          <p class="note">
            <strong>Interested in another area?</strong> Check our full module offer or contact us for more information.
          </p>
        </div>
      </section>

      <section id="campus" class="section">
        <div class="container">
          <h2>Campus and facilities</h2>
          <p>
            Practical classrooms, development labs and study spaces designed for project work throughout the academic year.
          </p>
          <div class="card-row">
            <article class="campus-card">
              <img src="https://picsum.photos/id/1018/700/440" alt="Exterior view of the training centre">
              <div class="course-body">
                <h3>Main building</h3>
                <p>Classrooms, student services and a library on a single accessible site.</p>
              </div>
            </article>
            <article class="campus-card">
              <img src="https://picsum.photos/id/1076/700/440" alt="Bright interior corridor of the campus">
              <div class="course-body">
                <h3>Study areas</h3>
                <p>Quiet rooms and group spaces open on weekdays until 21:00.</p>
              </div>
            </article>
            <article class="campus-card">
              <img src="https://picsum.photos/id/1048/700/440" alt="Workshop tables ready for practical sessions">
              <div class="course-body">
                <h3>Development labs</h3>
                <p>Workstations for web, databases and interface prototyping.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="contact" class="section section-alt">
        <div class="container contact-layout">
          <div>
            <h2>Contact</h2>
            <p>
              Do you have questions, suggestions or need more information about our courses? Fill in the form or use the direct channels below.
            </p>
            <ul class="contact-list">
              <li>Email: info@2daw.com</li>
              <li>Address: 15 Example Street, City</li>
            </ul>
          </div>
          <form class="contact-form" action="mailto:info@2daw.com" method="post" enctype="text/plain">
            <div class="form-field">
              <label for="fullName">Name</label>
              <input type="text" name="fullName" id="fullName" required>
            </div>
            <div class="form-field">
              <label for="email">Email</label>
              <input type="email" name="email" id="email" required>
            </div>
            <div class="form-field">
              <label for="message">Message</label>
              <textarea name="message" id="message" rows="4" required></textarea>
            </div>
            <button type="submit" class="btn">Send message</button>
          </form>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <div>
          <div class="footer-brand">2 DAW</div>
          <p>Inspiring students to learn, create and grow in the digital world.</p>
          <p class="thanks">Thank you for visiting us.</p>
        </div>
        <div>
          <h2>Quick links</h2>
          <ul>
            <li><a href="#about">About</a></li>
            <li><a href="#courses">Courses</a></li>
            <li><a href="#campus">Campus</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
        </div>
        <div>
          <h2>Social media</h2>
          <p>
            <a href="https://twitter.com/" target="_blank" rel="noopener">Twitter</a>
            <a href="https://facebook.com/" target="_blank" rel="noopener">Facebook</a>
          </p>
        </div>
        <div>
          <h2>Contact</h2>
          <p>info@2daw.com</p>
          <p>15 Example Street, City</p>
        </div>
      </div>
      <p class="copyright">
        &copy; <%= new Date().getFullYear() %> Educacion+ — Created by the <span>2DAW</span> team.
      </p>
      <div class="cookie-container">
        <span class="cookie-trigger" id="cookieBtn">Cookies</span>
        <div class="cookie-dropdown" id="cookieDropdown" style="display: none;">
          <p>Este sitio web utiliza cookies para mejorar la experiencia de usuario y su correcto funcionamiento.</p>
          <button type="button" id="cookieAcceptBtn">Aceptar</button>
        </div>
      </div>
    </footer>

    <script src="/javascripts/main.js"></script>
  </body>
</html>
